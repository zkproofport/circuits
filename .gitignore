# Noir artifacts (large files)
*.pk
*.ccs
*.so
*-keypair.json

# OMC (oh-my-claudecode)
.omc/

# Git worktrees
.worktree/

# Private inputs (contains sensitive witness data)
**/Prover.toml
# The same thing under another name: giwa_attestation has two fixtures because
# the circuit has two modes. Regenerate both with
# scripts/giwa-poc/make-fixtures.sh.
**/Prover.*.toml

# Proof outputs (contains witness-derived data)
**/target/proof/
**/target/proof_out/
**/target/*_witness.gz
# `nargo execute <name>` writes <name>.gz, and the acceptance runs name theirs
# witness_<case>, which the pattern above does not match.
**/target/witness*.gz

# Environment variables (contains sensitive keys)
.env
.env.development
.env.production

# Foundry build artifacts
out/
cache/

# Foundry dependencies (restore with: forge install)
lib/

# mDL test fixtures (contain personal info — do NOT commit)
mdl/kr-ownership/test-vectors/
mdl/kr-age/test-vectors/
mdl/kr-region/test-vectors/

# Acceptance fixtures and per-case logs, derived from the committed-nowhere
# Prover fixtures on every run. Any circuit, not a list that goes stale: arc
# grew a test-vectors/ the day after giwa did and the list had not moved.
**/test-vectors/

# Node dependencies for the helper scripts under scripts/ (see package.json).
node_modules/

# human_passport_score: its 2^21 reference string is 134,217,940 bytes, over
# GitHub's 100 MiB file limit, so it is not committed; its digest is still in
# target/SHA256SUMS. Hosting is undecided (human-passport-score/README.md).
human-passport-score/target/human_passport_score.srs
# nargo writes every source file's absolute path into the compiled json, so a
# local build names the builder's home directory. Committed circuit json comes
# from CI (build-circuits.yml), which does not build this prototype yet; the
# json, its SRS stamp and the manifest covering json + srs stay local until it
# does. vk, vk_hash and the Solidity verifier are path-free and committed.
human-passport-score/target/human_passport_score.json
human-passport-score/target/human_passport_score.srs.toolchain
human-passport-score/target/SHA256SUMS
# Executed only, never shipped: no artefacts to keep.
human-passport-real-issuer-check/target/
# Mutation copies, rebuilt on every run of scripts/human-passport/mutation-check.sh.
human-passport-mutant/
