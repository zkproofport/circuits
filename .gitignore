# Noir artifacts (large files)
*.pk
*.ccs
*.so
*-keypair.json

# OMC (oh-my-claudecode)
.omc/

# Git worktrees
.worktree/

# Private inputs (contains sensitive witness data)
**/Prover.toml
# The same thing under another name: giwa_attestation has two fixtures because
# the circuit has two modes. Regenerate both with
# scripts/giwa-poc/make-fixtures.sh.
**/Prover.*.toml

# Proof outputs (contains witness-derived data)
**/target/proof/
**/target/proof_out/
**/target/*_witness.gz
# `nargo execute <name>` writes <name>.gz, and the acceptance runs name theirs
# witness_<case>, which the pattern above does not match.
**/target/witness*.gz

# Environment variables (contains sensitive keys)
.env
.env.development
.env.production

# Foundry build artifacts
out/
cache/

# Foundry dependencies (restore with: forge install)
lib/

# Acceptance fixtures and per-case logs, derived from the committed-nowhere
# Prover fixtures on every run. Any circuit, not a list that goes stale: arc
# grew a test-vectors/ the day after giwa did and the list had not moved.
**/test-vectors/
# Except real Android key attestation chains (Apache-2.0, from
# github.com/android/keyattestation testdata), which the library's tests and
# scripts/android-key-attestation/export-vector.js read; they are inputs, not
# derived fixtures.
!android-key-attestation/test-vectors/

# Node dependencies for the helper scripts under scripts/ (see package.json).
node_modules/

# Statement-signer acceptance (coinbase_attestation_v2, oidc_domain_attestation):
# the synthetic-anchors copies and mutation copies are rebuilt from the
# sources on every run (scripts/statement-signer/).
coinbase-attestation-v2-synthetic-anchors/
coinbase-attestation-v2-mutant/
oidc-domain-attestation-synthetic-anchors/
oidc-domain-attestation-mutant/
statement-signer-synthetic-anchors/
statement-signer-mutant/
app-attest-libs-mutant/
oidc-domain-attestation-android-synthetic-anchors/
oidc-domain-attestation-android-mutant/
coinbase-attestation-v2-android-synthetic-anchors/
coinbase-attestation-v2-android-mutant/
android-key-attestation-mutant/
oidc-libs-mutant/
oidc-domain-attestation-android-factory-synthetic-anchors/
oidc-domain-attestation-android-factory-mutant/
coinbase-attestation-v2-android-factory-synthetic-anchors/
coinbase-attestation-v2-android-factory-mutant/
play-integrity-mutant/
# The synthetic RSA root the acceptance runs make on first use (anchors.js).
scripts/statement-signer/.synthetic-android-rsa-root.key.pem
coinbase-v2-libs-mutant/

# 2^21 reference strings are over GitHub's 100 MiB file limit: build.sh
# publishes them as <name>.srs.part0, .part1, ... and keeps the joined file
# local. Every circuit whose .srs is split is listed here; build.sh refuses to
# split one that is not.
oidc-domain-attestation-android/target/*.srs
coinbase-attestation-v2-android/target/*.srs
oidc-domain-attestation-android-factory/target/*.srs
coinbase-attestation-v2-android-factory/target/*.srs
# coinbase_country_attestation v2 (2026-10-30): the same acceptance copies,
# and the Android packages' 2^21 reference strings, published in parts.
coinbase-country-attestation-v2-synthetic-anchors/
coinbase-country-attestation-v2-mutant/
coinbase-country-attestation-v2-android-synthetic-anchors/
coinbase-country-attestation-v2-android-mutant/
coinbase-country-attestation-v2-android-factory-synthetic-anchors/
coinbase-country-attestation-v2-android-factory-mutant/
coinbase-country-v2-libs-mutant/
coinbase-country-attestation-v2-android/target/*.srs
coinbase-country-attestation-v2-android-factory/target/*.srs
# human_passport_score (2026-10-30): its 2^21 reference string is published in
# parts like the other 2^21 packages; mutation copies are rebuilt per run.
human-passport-score/target/*.srs
human-passport-mutant/
# Executed only, never shipped: no artefacts to keep.
human-passport-real-issuer-check/target/
