fn split_ca() -> ([u8; 48], [u8; 48], [u8; 48], [u8; 48]) {
    let mut x: [u8; 48] = [0; 48];
    let mut y: [u8; 48] = [0; 48];
    let mut r: [u8; 48] = [0; 48];
    let mut s: [u8; 48] = [0; 48];
    for i in 0..48 {
        x[i] = REAL_CA_KEY[i];
        y[i] = REAL_CA_KEY[48 + i];
        r[i] = REAL_SIG[i];
        s[i] = REAL_SIG[48 + i];
    }
    (x, y, r, s)
}

#[test]
fn apple_signed_this_certificate_with_sha256() {
    let (x, y, r, s) = split_ca();
    assert(verify_credential_signature(x, y, REAL_TBS, REAL_TBS_LEN, r, s));
}

#[test]
fn one_changed_byte_breaks_apples_signature() {
    let (x, y, r, s) = split_ca();
    let mut tbs = REAL_TBS;
    tbs[300] ^= 1; // inside the credential public key
    assert(!verify_credential_signature(x, y, tbs, REAL_TBS_LEN, r, s));
}

#[test]
fn the_real_certificate_parses_to_its_key_and_nonce() {
    let key = parse_credential_tbs(REAL_TBS, REAL_TBS_LEN, REAL_APP_ID);
    // SPKI BIT STRING at offset 313: 03 42 00 04 || x || y.
    for i in 0..32 {
        assert(key.x[i] == REAL_TBS[317 + i]);
        assert(key.y[i] == REAL_TBS[349 + i]);
    }
    // Nonce extension value at offset 814: 30 24 a1 22 04 20 || nonce.
    for i in 0..32 {
        assert(key.nonce[i] == REAL_TBS[820 + i]);
    }
}

#[test(should_fail_with = "Credential certificate is for another app")]
fn the_real_certificate_is_not_ours() {
    // Same length as zkPassport's id, one letter changed: the length checks
    // pass and the comparison has to do the refusing.
    let mut other = REAL_APP_ID;
    other[0] = 0x5a;
    let _ = parse_credential_tbs(REAL_TBS, REAL_TBS_LEN, other);
}

#[test(should_fail_with = "Credential certificate is for another app")]
fn our_app_id_does_not_match_theirs() {
    let ours = "R4G32CVY29.com.masselabs.zkproofport".as_bytes();
    let _ = parse_credential_tbs(REAL_TBS, REAL_TBS_LEN, ours);
}

#[test(should_fail_with = "TBS length does not match its header")]
fn a_wrong_length_is_refused() {
    let _ = parse_credential_tbs(REAL_TBS, REAL_TBS_LEN - 1, REAL_APP_ID);
}

#[test(should_fail_with = "TBS padding is not zero")]
fn bytes_after_the_tbs_are_refused() {
    let mut tbs = REAL_TBS;
    tbs[900] = 1;
    let _ = parse_credential_tbs(tbs, REAL_TBS_LEN, REAL_APP_ID);
}

#[test(should_fail_with = "Certificate is not signed with ecdsa-with-SHA256")]
fn another_signature_algorithm_is_refused() {
    let mut tbs = REAL_TBS;
    tbs[28] = 0x03; // ecdsa-with-SHA384
    let _ = parse_credential_tbs(tbs, REAL_TBS_LEN, REAL_APP_ID);
}
