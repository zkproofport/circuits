// A REAL Apple App Attest credential certificate, so the parser and the
// P-384 / SHA-256 check are tested against bytes Apple produced rather than
// bytes shaped like our own assumptions.
//
// Source: zkpassport/circuits at commit 9682885,
// src/noir/bin/facematch/ios/evm/src/tests.nr (Apache-2.0). A development-
// environment key of app YL5MS3Z639.app.zkpassport.appattest-prototype,
// issued 2025-08-26 by "Apple App Attestation CA 1". REAL_CA_KEY is that
// intermediate's key; scripts/coinbase-attestation-v2/check-apple-vector.js
// re-checks it against Apple's published root, and the signature against it.

use crate::credential::{parse_credential_tbs, verify_credential_signature};
use crate::intermediate::{INTERMEDIATE_TBS_MAX_LEN, parse_intermediate_tbs, verify_intermediate_signature};

