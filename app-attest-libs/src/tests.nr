global REAL_INTERMEDIATE_SIG: [u8; 96] = [
    0xbb, 0xbe, 0x88, 0x8d, 0x73, 0x8d, 0x05, 0x02, 0xcf, 0xbc, 0xfd, 0x66, 0x6d, 0x09, 0x57, 0x50,
    0x35, 0xbc, 0xd6, 0x87, 0x2c, 0x3f, 0x84, 0x30, 0x49, 0x26, 0x29, 0xed, 0xd1, 0xf9, 0x14, 0xe8,
    0x79, 0x99, 0x1c, 0x9a, 0xe8, 0xb5, 0xae, 0xf8, 0xd3, 0xa8, 0x54, 0x33, 0xf7, 0xb6, 0x0d, 0x06,
    0x54, 0xc7, 0x12, 0x2f, 0x33, 0x7e, 0x12, 0xff, 0x5b, 0xad, 0x3c, 0x45, 0xbb, 0x06, 0x6c, 0x9c,
    0x9a, 0xac, 0x01, 0x33, 0xd6, 0x80, 0xd1, 0x4a, 0xe7, 0xc3, 0xee, 0xc3, 0x99, 0xec, 0x63, 0x28,
    0xbe, 0xbd, 0xc2, 0x30, 0x3a, 0xb7, 0xa3, 0x42, 0x7d, 0x74, 0x11, 0xaf, 0x74, 0x30, 0xef, 0xbc,
];

fn split96(b: [u8; 96]) -> ([u8; 48], [u8; 48]) {
    let mut x: [u8; 48] = [0; 48];
    let mut y: [u8; 48] = [0; 48];
    for i in 0..48 {
        x[i] = b[i];
        y[i] = b[48 + i];
    }
    (x, y)
}

#[test]
fn apples_root_signed_ca_1_with_sha384() {
    let (rx, ry) = split96(APPLE_ROOT);
    let (r, s) = split96(REAL_INTERMEDIATE_SIG);
    assert(verify_intermediate_signature(rx, ry, REAL_INTERMEDIATE_TBS, REAL_INTERMEDIATE_TBS_LEN, r, s));
}

#[test]
fn one_changed_byte_breaks_the_roots_signature() {
    let (rx, ry) = split96(APPLE_ROOT);
    let (r, s) = split96(REAL_INTERMEDIATE_SIG);
    let mut tbs = REAL_INTERMEDIATE_TBS;
    tbs[300] ^= 1; // inside the intermediate public key
    assert(!verify_intermediate_signature(rx, ry, tbs, REAL_INTERMEDIATE_TBS_LEN, r, s));
}

#[test]
fn another_root_key_does_not_verify_ca_1() {
    // The intermediate's own key, on the curve, standing in for "some other root".
    let (rx, ry) = split96(REAL_CA_KEY);
    let (r, s) = split96(REAL_INTERMEDIATE_SIG);
    assert(!verify_intermediate_signature(rx, ry, REAL_INTERMEDIATE_TBS, REAL_INTERMEDIATE_TBS_LEN, r, s));
}

#[test]
fn ca_1_parses_to_the_key_that_signed_the_credential() {
    let ca = parse_intermediate_tbs(REAL_INTERMEDIATE_TBS, REAL_INTERMEDIATE_TBS_LEN);
    let (x, y) = split96(REAL_CA_KEY);
    assert(ca.x == x);
    assert(ca.y == y);
    // And that parsed key verifies the real credential certificate: the whole
    // real chain root -> CA 1 -> credential, in-circuit.
    let (_, _, r, s) = split_ca();
    assert(verify_credential_signature(ca.x, ca.y, REAL_TBS, REAL_TBS_LEN, r, s));
}

#[test(should_fail_with = "Intermediate is not a CA certificate")]
fn a_certificate_that_is_not_a_ca_is_refused() {
    let mut tbs = REAL_INTERMEDIATE_TBS;
    // basicConstraints value at 372: 30 06 01 01 FF 02 01 00 -> cA FALSE.
    // The root's signature no longer matches, but the parser must refuse on
    // its own: it is what stops a root-signed leaf acting as a CA.
    tbs[376] = 0x00;
    let _ = parse_intermediate_tbs(tbs, REAL_INTERMEDIATE_TBS_LEN);
}

#[test(should_fail_with = "Intermediate is not signed with ecdsa-with-SHA384")]
fn an_intermediate_with_another_algorithm_is_refused() {
    let mut tbs = REAL_INTERMEDIATE_TBS;
    tbs[38] = 0x02; // ecdsa-with-SHA256
    let _ = parse_intermediate_tbs(tbs, REAL_INTERMEDIATE_TBS_LEN);
}

#[test(should_fail_with = "Intermediate key is not an uncompressed P-384 key")]
fn an_intermediate_on_another_curve_is_refused() {
    let mut tbs = REAL_INTERMEDIATE_TBS;
    tbs[255] = 0x23; // secp384r1 (..22) -> secp521r1 (..23)
    let _ = parse_intermediate_tbs(tbs, REAL_INTERMEDIATE_TBS_LEN);
}

#[test(should_fail_with = "Intermediate TBS padding is not zero")]
fn bytes_after_the_intermediate_are_refused() {
    let mut tbs = REAL_INTERMEDIATE_TBS;
    tbs[500] = 1;
    let _ = parse_intermediate_tbs(tbs, REAL_INTERMEDIATE_TBS_LEN);
}

#[test(should_fail_with = "Intermediate TBS length does not match its header")]
fn a_wrong_intermediate_length_is_refused() {
    let _ = parse_intermediate_tbs(REAL_INTERMEDIATE_TBS, REAL_INTERMEDIATE_TBS_LEN + 1);
}
