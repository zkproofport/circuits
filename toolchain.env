# The circuit toolchain, named in exactly one place.
#
# scripts/build.sh, scripts/install-toolchain.sh, the build-circuits workflow
# and ../scripts/generate_srs.sh read this file. Nothing else may spell these
# versions out -- three copies of a version is how they drift.
#
# The set is decided by the phone, not by what is newest: mopro-ffi 0.3.7's
# Noir template uses noir-rs NOIR_RS_TAG, which links barretenberg-rs
# =BB_VERSION and executes circuits compiled by NARGO_VERSION. A circuit, its
# verification key and its Solidity verifier must come from this same set or
# the phone produces proofs nothing else accepts. Changing any line means
# rebuilding every circuit, redeploying every verifier and rebuilding mopro.
NARGO_VERSION=1.0.0-beta.19
BB_VERSION=4.2.0-aztecnr-rc.2
NOIR_RS_TAG=v1.0.0-beta.19
