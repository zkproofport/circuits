// Probe: what the Android signer alone costs -- the RKP chain under a pinned
// root, the key description, and one P-256 signature over a 313-byte
// statement (OIDC's). Not a circuit anyone proves.
use android_key_attestation::{AndroidChain, android_signing_key};

global ROOT_X: [u8; 48] = [0x23, 0xda, 0x23, 0x71, 0x4e, 0xdf, 0x3e, 0x5b, 0x05, 0x0a, 0x3c, 0x72, 0xe8, 0x84, 0x6a, 0xce, 0x07, 0x8e, 0xa0, 0xad, 0x1b, 0xf9, 0x8b, 0x15, 0xf4, 0x53, 0xd0, 0xcb, 0x08, 0xb2, 0xc3, 0xc1, 0x10, 0x45, 0x39, 0x09, 0xf6, 0xed, 0xea, 0xc1, 0xf9, 0xc8, 0xe0, 0x31, 0xa8, 0x48, 0xb9, 0x41];
global ROOT_Y: [u8; 48] = [0xa8, 0x29, 0x53, 0x5c, 0x97, 0xe0, 0x7c, 0x27, 0x19, 0xbe, 0xce, 0xb4, 0x16, 0x29, 0x0d, 0x30, 0x79, 0xee, 0xe1, 0xf9, 0x11, 0xcc, 0xe6, 0xdf, 0x80, 0x39, 0x14, 0xd8, 0xa3, 0x57, 0x7b, 0x34, 0xfd, 0xfd, 0x14, 0x3e, 0x5e, 0xf3, 0x6c, 0x97, 0x13, 0xc7, 0xac, 0x70, 0xa8, 0xc2, 0x11, 0xab];
global PKG: [u8; 25] = [0x63, 0x6f, 0x6d, 0x2e, 0x6d, 0x61, 0x73, 0x73, 0x65, 0x6c, 0x61, 0x62, 0x73, 0x2e, 0x7a, 0x6b, 0x70, 0x72, 0x6f, 0x6f, 0x66, 0x70, 0x6f, 0x72, 0x74];
global DIGEST: [u8; 32] = [0xc3, 0x9b, 0x40, 0x71, 0x87, 0xd8, 0x4c, 0xe5, 0x9e, 0x90, 0xbe, 0x7f, 0xcd, 0x0b, 0xe8, 0x34, 0xa2, 0x26, 0x78, 0x2c, 0x24, 0x02, 0x57, 0x10, 0x2f, 0x1d, 0x0a, 0x88, 0x16, 0xc6, 0x93, 0x1f];

fn main(chain: AndroidChain, now: pub u64, statement: [u8; 313], sig: [u8; 64]) {
    let (x, y) = android_signing_key(chain, ROOT_X, ROOT_Y, PKG, DIGEST, now);
    let d = sha256::digest(statement);
    assert(std::ecdsa_secp256r1::verify_signature(x, y, sig, d));
}
