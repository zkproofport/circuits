// Probe: what verifying one Play Integrity verdict costs, with the Play key a
// circuit constant (as statement-signer pins it). Not a circuit anyone proves.
use play_integrity::{IntegrityToken, verify_integrity_token};
global X: [u8; 32] = [0xf6, 0x61, 0xb9, 0x12, 0xc2, 0xcf, 0x40, 0x2b, 0x42, 0xe0, 0x94, 0x03, 0x4a, 0x0b, 0xc4, 0xe5, 0x65, 0x23, 0xa1, 0x76, 0x27, 0xc2, 0x6b, 0x75, 0x5e, 0x9d, 0x58, 0x7c, 0x43, 0x9d, 0x43, 0x3b];
global Y: [u8; 32] = [0x23, 0xc1, 0xb0, 0xcc, 0x56, 0x93, 0x7f, 0x41, 0x46, 0xc3, 0x07, 0xeb, 0xdb, 0x1a, 0x55, 0x16, 0x31, 0x8f, 0xd9, 0xe5, 0x0d, 0xf1, 0xe9, 0x9f, 0x2c, 0x4c, 0x55, 0x50, 0x4f, 0x0a, 0x67, 0x5b];
fn main(t: IntegrityToken, nonce: [u8; 32]) {
    verify_integrity_token(t, X, Y, "com.masselabs.zkproofport".as_bytes(), nonce);
}
